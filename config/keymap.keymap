// tsuki-keymap-bench: combo / hold-trigger positions use the S layout numbering
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "TD0";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LPAR>, <&kp LT>;
        };

        td1: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "TD1";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp RPAR>, <&kp GT>;
        };

        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            display-name = "HRM 左手";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 26 27 28 29 30 31 35 36 37 38 39 40 41 42 43>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        hmr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            display-name = "HRM 右手";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 25 32 33 34 35 36 37 38 39 40>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_1 {
            timeout-ms = <50>;
            key-positions = <22 23>;
            bindings = <&mkp LCLK>;
        };

        combo_2 {
            timeout-ms = <40>;
            key-positions = <28 29>;
            bindings = <&mkp RCLK>;
        };

    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            display-name = "layer_0";
            bindings = <
&trans  &trans   &trans        &trans       &trans       &trans                                &trans        &trans       &trans       &trans        &trans  &trans
&trans  &kp Q    &kp L         &kp U        &kp MINUS    &kp BSPC                              &kp F         &kp W        &kp R        &kp Y         &kp P   &trans
&trans  &kp E    &hml LSHFT I  &hml LALT A  &hml LGUI O  &hml LCTRL COMMA  &trans   &trans     &hmr RCTRL K  &hmr RGUI T  &hmr RALT N  &hmr RSHFT S  &kp H   &trans
&trans  &kp Z    &kp X         &kp C        &kp V        &kp DOT           &trans   &trans     &kp G         &kp D        &kp M        &kp J         &kp B   &trans
&trans  &kp ESC  &trans        &kp TAB      &lt 3 LANG2  &kp SPACE         &kp RET  &lt 1 TAB  &lt 2 LANG1   &none        &none        &trans        &trans  &trans
            >;
        };

        layer_1 {
            display-name = "layer_1";
            bindings = <
&trans  &trans     &trans  &trans  &trans  &trans                  &trans      &trans     &trans    &trans     &trans     &trans
&trans  &trans     &kp N7  &kp N8  &kp N9  &trans                  &trans      &trans     &trans    &trans     &kp PRCNT  &trans
&trans  &kp COLON  &kp N4  &kp N5  &kp N6  &trans  &trans  &trans  &kp LCTRL   &kp LGUI   &kp LALT  &kp LSHFT  &trans     &trans
&trans  &kp N0     &kp N1  &kp N2  &kp N3  &trans  &trans  &trans  &kp PLUS    &kp MINUS  &kp STAR  &kp FSLH   &trans     &trans
&trans  &trans     &trans  &trans  &trans  &trans  &trans  &trans  &caps_word  &trans     &trans    &trans     &trans     &trans
            >;
        };

        layer_2 {
            display-name = "layer_2";
            bindings = <
&trans  &trans     &trans    &trans     &trans    &trans                     &trans    &trans    &trans     &trans     &trans     &trans
&trans  &kp SQT    &kp DQT   &kp UNDER  &td0      &td1                       &trans    &trans    &trans     &kp CARET  &kp PRCNT  &trans
&trans  &kp EQUAL  &trans    &kp AMPS   &kp LBKT  &kp RBKT   &trans  &trans  &kp STAR  &kp SQT   &kp TILDE  &kp FSLH   &kp HASH   &trans
&trans  &trans     &kp SEMI  &kp COLON  &kp PIPE  &trans     &trans  &trans  &trans    &kp DLLR  &kp AT     &trans     &kp BSLH   &trans
&trans  &trans     &trans    &trans     &kp EXCL  &kp QMARK  &trans  &trans  &kp TAB   &trans    &trans     &trans     &trans     &trans
            >;
        };

        layer_3 {
            display-name = "layer_3";
            bindings = <
&trans  &trans        &trans        &trans        &trans        &trans                        &trans    &trans    &trans  &trans     &trans  &trans
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                  &mkp MB4  &mkp MB5  &trans  &trans     &trans  &trans
&trans  &trans        &kp LSHFT     &kp LCTRL     &kp LGUI      &kp LCTRL     &trans  &trans  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans  &trans
&trans  &trans        &trans        &out OUT_USB  &out OUT_BLE  &bt BT_NXT    &trans  &trans  &trans    &trans    &trans  &trans     &trans  &trans
&trans  &trans        &trans        &trans        &trans        &kp TAB       &trans  &trans  &trans    &trans    &trans  &trans     &trans  &trans
            >;
        };

        layer_4 {
            display-name = "layer_4";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

    };
};
